# Build-time config for the deployed app.
#
# Committed deliberately. Both values are public by design: NEXT_PUBLIC_* vars are
# inlined into the client bundle by Next.js either way, and the Supabase
# publishable key is meant to ship in a browser. It has SELECT on the rig row and
# no write access to anything (see supabase/migrations/0001_vdemo.sql).
#
# The payoff is that a fresh clone deploys with zero configuration — there is no
# environment-variable step to forget on the morning of an event.
#
# There is no secret key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://unztaxuvycyxllvfalzx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zcuCgA8tGnQIWrbioL1v2w_NepmIcVx
