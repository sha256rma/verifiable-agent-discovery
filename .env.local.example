# Supabase project: Project Settings -> Data API (URL) and API Keys (publishable key).
#
# Only TWO variables, and both are public by design. There is no secret key in
# this app: the browser key has SELECT on the rig row and no write access
# anywhere, and every state transition goes through a SECURITY DEFINER Postgres
# function. Nothing sensitive to leak, nothing to rotate before a demo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
